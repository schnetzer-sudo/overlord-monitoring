# Vorlage für die lokale Konfiguration des Frontends.
#
# Kopieren nach .env.local (von .gitignore ausgeschlossen) und anpassen. In
# dieser Datei stehen KEINE Zugangsdaten und keine echten Hostnamen — nur der
# lokale Standard.
#
#   cp .env.example .env.local

# Adresse des Backends, an die der Rewrite aus next.config.ts /api weiterreicht.
# Der Browser sieht diese Adresse nie: Er spricht ausschließlich mit Next.js.
# Deshalb ist die Variable auch NICHT mit NEXT_PUBLIC_ vorangestellt — sie bleibt
# serverseitig. Sie wirkt beim Bau (pnpm build), nicht beim Start: next start
# liest die Weiterleitung aus .next/routes-manifest.json (docs/betrieb.md §3).
OVERLORD_BACKEND_URL=http://localhost:8080
