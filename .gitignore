scripts/messung-schritt10/ergebnis/
scripts/messung-schritt10b/ergebnis/
scripts/messung-schritt10b-1/ergebnis/
scripts/messung-liste-verengung/ergebnis/

# ─── Quelltext des Altwerkzeugs ──────────────────────────────────────────────
# alterCode/ bleibt LOKAL. JsonServlet.java traegt drei produktive absolute
# Pfade mit einem Produktionsknoten- und einem Dienstkontonamen; CLAUDE.md
# schliesst Hostnamen und Produktionsdaten im Repository aus, und ein Push ist
# in der Historie praktisch dauerhaft. Entschieden am 17.08.2026.
#
# Die vier Dateien des Filestore-Clients liegen byteidentisch unter
# scripts/mitschnitt-saaj/ und sind dort eingecheckt - sie tragen keine
# produktiven Pfade. Die Fundstellen in Abschnitt Q von
# docs/messungen-schritt8.md verweisen auf den lokalen Bestand.
alterCode/

# ─── M70 — Mitschnitt des SAAJ-Aufrufs ───────────────────────────────────────
# pom.xml, main und Lauscher werden eingecheckt — sie sind der Beleg dafuer,
# wie gemessen wurde. Bauverzeichnis, Mitschnitt und das Wegwerf-Zielverzeichnis
# des Abrufs nicht.
scripts/mitschnitt-saaj/target/
scripts/mitschnitt-saaj/mitschnitt/
scripts/mitschnitt-saaj/retrieve/
scripts/mitschnitt-saaj/arbeit/
scripts/mitschnitt-saaj/abhaengigkeiten.txt

# ─── M72 — derselbe Mitschnitt, jakarta-Zweig ────────────────────────────────
# Gleiche Trennung: pom.xml, Quellen und m72.ps1 eingecheckt, Laufergebnisse
# nicht. Die beiden .bin sind die Mitschnitte selbst.
scripts/mitschnitt-saaj-jakarta/target/
scripts/mitschnitt-saaj-jakarta/mitschnitt/
scripts/mitschnitt-saaj-jakarta/retrieve/
scripts/mitschnitt-saaj-jakarta/abhaengigkeiten.txt
scripts/mitschnitt-saaj-jakarta/*.bin
