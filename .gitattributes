# Zeilenenden verbindlich festlegen.
#
# Ohne diese Datei haengt das Ergebnis an der lokalen Einstellung core.autocrlf:
# Unter Windows schreibt Spotless dann CRLF, unter Linux LF — und
# "./mvnw verify" schlaegt je nach Rechner an der Formatpruefung fehl, ohne
# dass jemand etwas geaendert haette. Passend dazu .editorconfig.

# Standard: Git speichert LF und checkt LF aus — auf jeder Plattform.
* text=auto eol=lf

# Ausnahme: Windows-Batchdateien brauchen CRLF.
*.cmd text eol=crlf
*.bat text eol=crlf

# Der Maven-Wrapper ist ein POSIX-Shellskript und bleibt LF.
mvnw text eol=lf

# Ausnahme: die kopierten Alt-Dateien des Filestore-Clients.
# M70 und M71 belegen ihre Byteidentitaet mit dem Original ueber SHA-256. Eine
# Normalisierung CRLF -> LF wuerde genau diese Pruefsummen brechen, und zwar
# still: Der Arbeitsbaum saehe unveraendert aus, ein frischer Klon nicht. Sie
# werden deshalb als binaer behandelt und Byte fuer Byte gespeichert, wie sie
# geliefert wurden.
scripts/mitschnitt-saaj/src/main/java/de/kraftwerkone/filestore/client/*.java -text

# Dieselbe Ausnahme fuer die jakarta-Kopie aus M72. Drei der vier Dateien sind
# byteidentisch mit dem Original, die vierte unterscheidet sich in genau zwei
# import-Zeilen — beides ist nur nachweisbar, solange Git nichts normalisiert.
scripts/mitschnitt-saaj-jakarta/src/main/java/de/kraftwerkone/filestore/client/*.java -text

# Generierte jOOQ-Quellen: eingecheckt (die CI erreicht die Testkopie nicht), aber
# in Diffs und Sprachstatistik als generiert markiert.
src/main/generated-java/** linguist-generated=true

# Binaerdateien nie umschreiben.
*.jar   binary
*.zip   binary
*.gz    binary
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.webp  binary
*.avif  binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.otf   binary
*.pdf   binary
