# Overlord Monitoring — Vorlage fuer die lokale Umgebung
#
#   cp .env.example .env
#
# .env ist von Git ignoriert und wird NIEMALS eingecheckt.
# In dieser Vorlage stehen ausschliesslich Platzhalter — keine echten
# Hostnamen, keine echten Zugangsdaten. (Regel G1)
#
# Die Datei wird nicht automatisch eingelesen. Sie ist die dokumentierte Liste
# der Umgebungsvariablen; beim Start werden sie ueber die Shell, den
# systemd-Dienst oder die Container-Umgebung gesetzt. Beispiel fuer bash:
#
#   set -a && . ./.env && set +a && ./mvnw spring-boot:run

# ─── Profil ─────────────────────────────────────────────────────────────────
# dev (Standard, wenn nichts gesetzt ist) oder prod.
SPRING_PROFILES_ACTIVE=dev

# ─── Server ─────────────────────────────────────────────────────────────────
SERVER_PORT=8080

# ─── Protokollierung ────────────────────────────────────────────────────────
# Gueltige Werte: TRACE, DEBUG, INFO, WARN, ERROR
LOG_LEVEL_ROOT=INFO
LOG_LEVEL_APP=DEBUG

# ─── Datenbank (Testkopie bzw. Produktion) ──────────────────────────────────
# Zwei Benutzer auf derselben MariaDB-Instanz:
#   Lese-Benutzer  — ausschliesslich SELECT auf beide Schemata
#   Schreib-Benutzer — SELECT auf GlassfishDB, ALL PRIVILEGES auf overlord_monitor
# Kein Benutzer dieser Anwendung erhaelt jemals ein Schreibrecht auf GlassfishDB. (Regel S1)
#
# Hier stehen ausschliesslich Platzhalter — niemals echte Hostnamen oder
# Passwoerter. (Regel G1)
OVERLORD_DB_HOST=
OVERLORD_DB_PORT=3306
OVERLORD_DB_GLASSFISH_SCHEMA=GlassfishDB
OVERLORD_DB_MONITOR_SCHEMA=overlord_monitor
OVERLORD_DB_READ_USER=
OVERLORD_DB_READ_PASSWORD=
OVERLORD_DB_WRITE_USER=
OVERLORD_DB_WRITE_PASSWORD=
