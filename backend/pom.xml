<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.0</version>
    <relativePath/>
  </parent>

  <!--
    Basispaket ist de.kraftwerkone.overlord.monitor.
    Achtung: Aus groupId + artifactId wuerde de.kraftwerkone.overlordmonitor abgeleitet.
    Das ist NICHT das Basispaket dieses Projekts. Siehe DEVELOPMENT_GUIDELINES.md, Abschnitt 2.
  -->
  <groupId>de.kraftwerkone</groupId>
  <artifactId>overlord-monitor</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <name>overlord-monitor</name>
  <description>Monitoring-Werkzeug fuer die EDI-Integrationsplattform Overlord</description>

  <properties>
    <java.version>21</java.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

    <archunit.version>1.4.2</archunit.version>
    <spotless-maven-plugin.version>3.8.0</spotless-maven-plugin.version>
    <google-java-format.version>1.35.0</google-java-format.version>

    <!--
      Die jOOQ-Codegenerierung laeuft bei jedem lokalen Build gegen die Testkopie.
      Ihre Ausgabe (src/main/generated-java) wird EINGECHECKT. Die CI erreicht die
      Testkopie im internen Netz nicht und setzt daher -Djooq.codegen.skip=true; sie
      kompiliert gegen die versionierten Quellen. Standard hier ist false.
      Siehe docs/datenzugriff.md und DEVELOPMENT_GUIDELINES.md.
    -->
    <jooq.codegen.skip>false</jooq.codegen.skip>

    <!--
      Verzeichnis der generierten jOOQ-Quellen. Wird versioniert, per build-helper
      als Quellverzeichnis ergaenzt und von Spotless bewusst NICHT angefasst.
    -->
    <jooq.generated.dir>${project.basedir}/src/main/generated-java</jooq.generated.dir>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>

    <!--
      Datenzugriff. In Spring Boot 4 ist die Autokonfiguration modularisiert: jedes
      Starter bringt sein eigenes ...autoconfigure-Modul mit. spring-boot-starter-jooq
      zieht spring-boot-starter-jdbc (HikariCP, spring-jdbc) transitiv mit; beide sind
      hier trotzdem explizit genannt, damit die Abhaengigkeit sichtbar bleibt.
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-jdbc</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-jooq</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-flyway</artifactId>
    </dependency>

    <!-- Flyway spricht MariaDB ueber das flyway-mysql-Modul an. -->
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-mysql</artifactId>
      <scope>runtime</scope>
    </dependency>

    <!-- MariaDB Connector/J. Version wird vom Spring-Boot-BOM verwaltet. -->
    <dependency>
      <groupId>org.mariadb.jdbc</groupId>
      <artifactId>mariadb-java-client</artifactId>
      <scope>runtime</scope>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <!--
      ArchUnit bewusst als Kern-Artefakt, nicht als archunit-junit5.
      Spring Boot 4.1 liefert JUnit Jupiter 6 und damit JUnit Platform 6; die
      ArchUnit-JUnit5-Engine zielt auf Platform 1.x. Der Kern ist von der
      Test-Engine unabhaengig und wird aus normalen @Test-Methoden aufgerufen.
    -->
    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit</artifactId>
      <version>${archunit.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>

      <!--
        Failsafe fuehrt die Integrationstests (*IT) in der Phase "verify" aus.
        Sie tragen alle @Tag("db") und laufen lokal gegen die Testkopie mit; die
        CI schliesst die Gruppe ueber -DexcludedGroups=db aus (dieselbe Eigenschaft
        wie bei Surefire). Version aus dem Spring-Boot-BOM.
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <executions>
          <execution>
            <goals>
              <goal>integration-test</goal>
              <goal>verify</goal>
            </goals>
          </execution>
        </executions>
      </plugin>

      <!--
        Spotless ist im Build verankert: "spotless:check" haengt an der Phase
        "validate". "./mvnw verify" schlaegt damit bei Formatverstoessen fehl,
        bevor ueberhaupt kompiliert wird. Reparatur: ./mvnw spotless:apply
      -->
      <plugin>
        <groupId>com.diffplug.spotless</groupId>
        <artifactId>spotless-maven-plugin</artifactId>
        <version>${spotless-maven-plugin.version}</version>
        <configuration>
          <java>
            <!--
              Nur handgeschriebener Code. Die generierten jOOQ-Quellen unter
              src/main/generated-java werden von build-helper als Quellverzeichnis
              ergaenzt; ohne die explizite Einschraenkung wuerde Spotless sie mit
              formatieren und der Build bei jeder Neugenerierung anschlagen.
            -->
            <includes>
              <include>src/main/java/**/*.java</include>
              <include>src/test/java/**/*.java</include>
            </includes>
            <googleJavaFormat>
              <version>${google-java-format.version}</version>
              <style>GOOGLE</style>
            </googleJavaFormat>
            <!--
              Kein separates removeUnusedImports: googleJavaFormat raeumt Importe
              bereits mit auf. Der eigene Schritt zoege nur eine zweite, aeltere
              google-java-format-Version in den Build.
            -->
            <formatAnnotations/>
          </java>
          <pom>
            <includes>
              <include>pom.xml</include>
            </includes>
            <endWithNewline/>
            <trimTrailingWhitespace/>
          </pom>
          <formats>
            <format>
              <includes>
                <include>src/main/resources/**/*.yml</include>
                <include>src/test/resources/**/*.yml</include>
              </includes>
              <endWithNewline/>
              <trimTrailingWhitespace/>
              <indent>
                <spaces>true</spaces>
                <spacesPerTab>2</spacesPerTab>
              </indent>
            </format>
          </formats>
        </configuration>
        <executions>
          <execution>
            <id>spotless-check</id>
            <phase>validate</phase>
            <goals>
              <goal>check</goal>
            </goals>
          </execution>
        </executions>
      </plugin>

      <!--
        jOOQ-Codegenerierung, zwei Ausfuehrungen in zwei getrennte Zielpakete.
        Der Generator laeuft mit dem Schreibbenutzer (monitor_root), weil er auch
        das eigene Schema liest; auf GlassfishDB besitzt auch dieser Benutzer nur
        SELECT. Keine eigene <version> — sie kommt aus dem Spring-Boot-BOM und ist
        damit an die Laufzeit-jOOQ-Version (3.21.x) gekoppelt.

        Zugangsdaten stehen NICHT hier, sondern kommen ueber Umgebungsvariablen
        (${env.*}). Ausgabeverzeichnis ist src/main/generated-java und wird
        eingecheckt. Uebersprungen ueber -Djooq.codegen.skip=true (CI).
      -->
      <plugin>
        <groupId>org.jooq</groupId>
        <artifactId>jooq-codegen-maven</artifactId>
        <dependencies>
          <dependency>
            <groupId>org.mariadb.jdbc</groupId>
            <artifactId>mariadb-java-client</artifactId>
            <version>${mariadb.version}</version>
          </dependency>
        </dependencies>
        <executions>
          <!-- GlassfishDB: Quellschema, ausschliesslich lesend. -->
          <execution>
            <id>codegen-glassfish</id>
            <phase>generate-sources</phase>
            <goals>
              <goal>generate</goal>
            </goals>
            <configuration>
              <skip>${jooq.codegen.skip}</skip>
              <jdbc>
                <driver>org.mariadb.jdbc.Driver</driver>
                <url>jdbc:mariadb://${env.OVERLORD_DB_HOST}:${env.OVERLORD_DB_PORT}/${env.OVERLORD_DB_GLASSFISH_SCHEMA}</url>
                <user>${env.OVERLORD_DB_WRITE_USER}</user>
                <password>${env.OVERLORD_DB_WRITE_PASSWORD}</password>
              </jdbc>
              <generator>
                <database>
                  <name>org.jooq.meta.mariadb.MariaDBDatabase</name>
                  <inputSchema>${env.OVERLORD_DB_GLASSFISH_SCHEMA}</inputSchema>
                  <includes>.*</includes>
                  <!-- Views einschliessen (MessageMandantID); Routinen, Sequenzen,
                       Pakete und UDTs ausschliessen. -->
                  <includeTables>true</includeTables>
                  <includeRoutines>false</includeRoutines>
                  <includeSequences>false</includeSequences>
                  <includePackages>false</includePackages>
                  <includeUDTs>false</includeUDTs>
                  <forcedTypes>
                    <!-- bit(1) -> Boolean, betrifft Message.Source und Message.Target. -->
                    <forcedType>
                      <name>BOOLEAN</name>
                      <includeTypes>(?i:BIT\(1\))</includeTypes>
                    </forcedType>
                  </forcedTypes>
                </database>
                <target>
                  <packageName>de.kraftwerkone.overlord.monitor.jooq.glassfish</packageName>
                  <directory>${jooq.generated.dir}</directory>
                </target>
              </generator>
            </configuration>
          </execution>
          <!-- overlord_monitor: eigenes Schema, schreibend. -->
          <execution>
            <id>codegen-monitor</id>
            <phase>generate-sources</phase>
            <goals>
              <goal>generate</goal>
            </goals>
            <configuration>
              <skip>${jooq.codegen.skip}</skip>
              <jdbc>
                <driver>org.mariadb.jdbc.Driver</driver>
                <url>jdbc:mariadb://${env.OVERLORD_DB_HOST}:${env.OVERLORD_DB_PORT}/${env.OVERLORD_DB_MONITOR_SCHEMA}</url>
                <user>${env.OVERLORD_DB_WRITE_USER}</user>
                <password>${env.OVERLORD_DB_WRITE_PASSWORD}</password>
              </jdbc>
              <generator>
                <database>
                  <name>org.jooq.meta.mariadb.MariaDBDatabase</name>
                  <inputSchema>${env.OVERLORD_DB_MONITOR_SCHEMA}</inputSchema>
                  <includes>.*</includes>
                  <!-- Flyways Buchhaltungstabelle gehoert nicht ins Modell. -->
                  <excludes>flyway_schema_history</excludes>
                  <includeTables>true</includeTables>
                  <includeRoutines>false</includeRoutines>
                  <includeSequences>false</includeSequences>
                  <includePackages>false</includePackages>
                  <includeUDTs>false</includeUDTs>
                  <forcedTypes>
                    <forcedType>
                      <name>BOOLEAN</name>
                      <includeTypes>(?i:BIT\(1\))</includeTypes>
                    </forcedType>
                  </forcedTypes>
                </database>
                <target>
                  <packageName>de.kraftwerkone.overlord.monitor.jooq.monitor</packageName>
                  <directory>${jooq.generated.dir}</directory>
                </target>
              </generator>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <!--
        Fuegt die generierten jOOQ-Quellen als Quellverzeichnis hinzu. Ohne diesen
        Schritt kompiliert der handgeschriebene Code nicht gegen die generierten
        Typen. Version aus dem Spring-Boot-BOM.
      -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>build-helper-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>add-generated-jooq</id>
            <phase>generate-sources</phase>
            <goals>
              <goal>add-source</goal>
            </goals>
            <configuration>
              <sources>
                <source>${jooq.generated.dir}</source>
              </sources>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <!--
        Flyway als Maven-Plugin, ausschliesslich fuer overlord_monitor. Bewusst NICHT
        an eine Bauphase gebunden: die CI erreicht die Datenbank nicht. Manuell
        aufgerufen (./mvnw flyway:migrate), um das Schema vor der ersten
        Codegenerierung anzulegen. Zur Laufzeit migriert Spring Boot ueber
        @FlywayDataSource. Zugangsdaten ueber Umgebungsvariablen.
      -->
      <plugin>
        <groupId>org.flywaydb</groupId>
        <artifactId>flyway-maven-plugin</artifactId>
        <configuration>
          <url>jdbc:mariadb://${env.OVERLORD_DB_HOST}:${env.OVERLORD_DB_PORT}/${env.OVERLORD_DB_MONITOR_SCHEMA}</url>
          <user>${env.OVERLORD_DB_WRITE_USER}</user>
          <password>${env.OVERLORD_DB_WRITE_PASSWORD}</password>
          <schemas>
            <schema>${env.OVERLORD_DB_MONITOR_SCHEMA}</schema>
          </schemas>
          <defaultSchema>${env.OVERLORD_DB_MONITOR_SCHEMA}</defaultSchema>
          <createSchemas>false</createSchemas>
          <baselineOnMigrate>false</baselineOnMigrate>
          <locations>
            <location>filesystem:src/main/resources/db/migration</location>
          </locations>
        </configuration>
        <dependencies>
          <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-mysql</artifactId>
            <version>${flyway.version}</version>
          </dependency>
          <dependency>
            <groupId>org.mariadb.jdbc</groupId>
            <artifactId>mariadb-java-client</artifactId>
            <version>${mariadb.version}</version>
          </dependency>
        </dependencies>
      </plugin>
    </plugins>
  </build>
</project>
